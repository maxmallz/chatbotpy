# chatbotpy talks to data only through core-svc over HTTP. It holds no database URLs.
CORE_SVC_URL=http://127.0.0.1:8080

# Claude through the Anthropic SDK. Leave AGENT_MODEL=offline to run a rule-based agent that
# calls the same tools without an API key (used by automation when no key is set).
AGENT_MODEL=claude-opus-5-5
AGENT_EFFORT=low
ANTHROPIC_API_KEY=

# HTTP server
HOST=127.0.0.1
PORT=8088
